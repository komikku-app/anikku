CREATE TABLE libraryUpdateError (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    anime_id INTEGER NOT NULL UNIQUE,
    message_id INTEGER NOT NULL,
    last_update INTEGER NOT NULL DEFAULT 0
);

getAllErrors:
SELECT *
FROM libraryUpdateError;

insert:
INSERT INTO libraryUpdateError(anime_id, message_id, last_update) VALUES (:animeId, :messageId, strftime('%s', 'now'));

upsert:
INSERT INTO libraryUpdateError(anime_id, message_id, last_update)
VALUES (:animeId, :messageId, strftime('%s', 'now'))
ON CONFLICT(anime_id)
DO UPDATE
SET
    message_id = :messageId,
    last_update = strftime('%s', 'now')
WHERE anime_id = :animeId;

deleteAllErrors:
DELETE FROM libraryUpdateError;

deleteErrors:
DELETE FROM libraryUpdateError
WHERE _id IN :_ids;

deleteAnimeErrors:
DELETE FROM libraryUpdateError
WHERE anime_id IN :animeIds;

cleanUnrelevantAnimeErrors:
DELETE FROM libraryUpdateError
WHERE NOT EXISTS (
    SELECT 1
    FROM animes
    WHERE libraryUpdateError.anime_id = animes._id
    AND animes.favorite == 1
);
