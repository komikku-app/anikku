DROP VIEW IF EXISTS historyView;

CREATE VIEW historyView AS
SELECT
    history._id AS id,
    animes._id AS animeId,
    episodes._id AS episodeId,
    animes.title,
    animes.thumbnail_url AS thumbnailUrl,
    animes.source,
    animes.favorite,
    animes.cover_last_modified,
    episodes.episode_number AS episodeNumber,
    -- KMK -->
    animes.episode_flags AS episodeFlags,
    episodes.seen AS seen,
    episodes.last_second_seen AS lastSecondSeen,
    episodes.total_seconds AS totalSeconds,
    coalesce(EP.total, 0) AS totalCount,
    coalesce(EP.seenCount, 0) AS seenCount,
    coalesce(EP.bookmarkCount, 0) AS bookmarkCount,
    coalesce(EP.bookmarkSeenCount, 0) AS bookmarkSeenCount,
    -- KMK <--
    history.last_seen AS seenAt,
    history.time_watch AS watchDuration,
    max_last_seen.last_seen AS maxSeenAt,
    max_last_seen.episode_id AS maxSeenAtEpisodeId
FROM animes
JOIN episodes
ON animes._id = episodes.anime_id
JOIN history
ON episodes._id = history.episode_id
JOIN (
    SELECT episodes.anime_id,episodes._id AS episode_id, MAX(history.last_seen) AS last_seen
    FROM episodes JOIN history
    ON episodes._id = history.episode_id
    GROUP BY episodes.anime_id
) AS max_last_seen
ON episodes.anime_id = max_last_seen.anime_id
-- KMK -->
LEFT JOIN(
    SELECT
        episodes.anime_id,
        count(*) AS total,
        sum(seen) AS seenCount,
        sum(bookmark) AS bookmarkCount,
        sum(CASE WHEN bookmark = 1 AND seen = 1 THEN 1 ELSE 0 END) AS bookmarkSeenCount,
        excluded_scanlators.scanlator AS ex_scanlator
    FROM episodes
    LEFT JOIN excluded_scanlators
    ON episodes.anime_id = excluded_scanlators.anime_id
    AND episodes.scanlator = excluded_scanlators.scanlator
    WHERE ex_scanlator IS NULL
    GROUP BY episodes.anime_id
) AS EP
ON animes._id = EP.anime_id;
-- KMK <--

DROP VIEW IF EXISTS libraryView;

CREATE VIEW libraryView AS
SELECT
    A.*,
    coalesce(EP.total, 0) AS totalCount,
    coalesce(EP.seenCount, 0) AS seenCount,
    coalesce(EP.latestUpload, 0) AS latestUpload,
    coalesce(EP.fetchedAt, 0) AS episodeFetchedAt,
    coalesce(EP.lastSeen, 0) AS lastSeen,
    coalesce(EP.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(EP.bookmarkSeenCount, 0) AS bookmarkedSeenCount,
    -- KMK <--
    -- AY -->
    coalesce(EP.fillermarkCount, 0) AS fillermarkCount,
    -- <-- AY
    coalesce(AC.category_id, 0) AS category
FROM animes A
LEFT JOIN(
    SELECT
        episodes.anime_id,
        count(*) AS total,
        sum(seen) AS seenCount,
        coalesce(max(episodes.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_seen), 0) AS lastSeen,
        coalesce(max(episodes.date_fetch), 0) AS fetchedAt,
        sum(episodes.bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN episodes.bookmark = 1 AND episodes.seen = 1 THEN 1 ELSE 0 END) AS bookmarkSeenCount,
        -- KMK <--
        excluded_scanlators.scanlator AS ex_scanlator,
        -- AY -->
        sum(episodes.fillermark) AS fillermarkCount
        -- <-- AY
    FROM episodes
    LEFT JOIN excluded_scanlators
    ON episodes.anime_id = excluded_scanlators.anime_id
    AND episodes.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON episodes._id = history.episode_id
    WHERE ex_scanlator IS NULL
    GROUP BY episodes.anime_id
) AS EP
ON A._id = EP.anime_id
LEFT JOIN animes_categories AS AC
ON AC.anime_id = A._id
WHERE A.source <> 6969
UNION
SELECT
    A.*,
    coalesce(EP.total, 0) AS totalCount,
    coalesce(EP.seenCount, 0) AS seenCount,
    coalesce(EP.latestUpload, 0) AS latestUpload,
    coalesce(EP.fetchedAt, 0) AS episodeFetchedAt,
    coalesce(EP.lastSeen, 0) AS lastSeen,
    coalesce(EP.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(EP.bookmarkSeenCount, 0) AS bookmarkedSeenCount,
    -- KMK <--
    -- AY -->
    coalesce(EP.fillermarkCount, 0) AS fillermarkCount,
    -- <-- AY
    coalesce(AC.category_id, 0) AS category
FROM animes A
LEFT JOIN (
    SELECT merged.anime_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = A._id
LEFT JOIN(
    SELECT
        ME.merge_id,
        count(*) AS total,
        sum(seen) AS seenCount,
        coalesce(max(episodes.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_seen), 0) AS lastSeen,
        coalesce(max(episodes.date_fetch), 0) AS fetchedAt,
        sum(episodes.bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN episodes.bookmark = 1 AND episodes.seen = 1 THEN 1 ELSE 0 END) AS bookmarkSeenCount,
        -- KMK <--
        excluded_scanlators.scanlator AS ex_scanlator,
        -- AY -->
        sum(episodes.fillermark) AS fillermarkCount
        -- <-- AY
    FROM episodes
    LEFT JOIN excluded_scanlators
    ON episodes.anime_id = excluded_scanlators.anime_id
    AND episodes.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON episodes._id = history.episode_id
    LEFT JOIN merged ME
    ON ME.anime_id = episodes.anime_id
    WHERE ex_scanlator IS NULL
    GROUP BY ME.merge_id
) AS EP
ON A._id = EP.merge_id  -- ON ME.merge_id = EP.merge_id
LEFT JOIN animes_categories AS AC
ON AC.anime_id = A._id
WHERE A.source = 6969;
