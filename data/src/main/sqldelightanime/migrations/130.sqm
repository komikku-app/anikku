-- Add fetch type column, all current entries are episodes
ALTER TABLE animes ADD COLUMN fetch_type INTEGER NOT NULL DEFAULT 1;

-- Add parent id column
ALTER TABLE animes ADD COLUMN parent_id INTEGER;

-- Add season flags column
ALTER TABLE animes ADD COLUMN season_flags INTEGER NOT NULL DEFAULT 0;

-- Add season number column
ALTER TABLE animes ADD COLUMN season_number REAL NOT NULL DEFAULT -1.0;

-- Add source order for seasons
ALTER TABLE animes ADD COLUMN season_source_order INTEGER NOT NULL DEFAULT 0;

-- Create Index
DROP INDEX IF EXISTS animes_parent_id;
DROP INDEX IF EXISTS animes_fetch_type;
CREATE INDEX animes_parent_id ON animes(parent_id);
CREATE INDEX animes_fetch_type ON animes(fetch_type);

-- Create views
DROP VIEW IF EXISTS episodestatsView;
CREATE VIEW episodestatsView AS
SELECT
    episodes.anime_id,
    count(*) AS total,
    sum(seen) AS seenCount,
    coalesce(max(episodes.date_upload), 0) AS latestUpload,
    coalesce(max(history.last_seen), 0) AS lastSeen,
    coalesce(max(episodes.date_fetch), 0) AS fetchedAt,
    sum(episodes.bookmark) AS bookmarkCount,
    excluded_scanlators.scanlator AS ex_scanlator,
    -- AM (FILLERMARK) -->
    sum(episodes.fillermark) AS fillermarkCount
    -- <-- AM (FILLERMARK)
FROM episodes
LEFT JOIN excluded_scanlators
ON episodes.anime_id = excluded_scanlators.anime_id
AND episodes.scanlator = excluded_scanlators.scanlator
LEFT JOIN history ON episodes._id = history.episode_id
WHERE ex_scanlator IS NULL
GROUP BY episodes.anime_id;

DROP VIEW IF EXISTS mergedepisodestatsView;
CREATE VIEW mergedepisodestatsView AS
SELECT
    ME.merge_id,
    count(*) AS total,
    sum(seen) AS seenCount,
    coalesce(max(episodes.date_upload), 0) AS latestUpload,
    coalesce(max(history.last_seen), 0) AS lastSeen,
    coalesce(max(episodes.date_fetch), 0) AS fetchedAt,
    sum(episodes.bookmark) AS bookmarkCount,
    excluded_scanlators.scanlator AS ex_scanlator,
    -- AM (FILLERMARK) -->
    sum(episodes.fillermark) AS fillermarkCount
    -- <-- AM (FILLERMARK)
FROM episodes
LEFT JOIN excluded_scanlators
ON episodes.anime_id = excluded_scanlators.anime_id
AND episodes.scanlator = excluded_scanlators.scanlator
LEFT JOIN history
ON episodes._id = history.episode_id
LEFT JOIN merged ME
ON ME.anime_id = episodes.anime_id
WHERE ex_scanlator IS NULL
GROUP BY ME.merge_id;

DROP VIEW IF EXISTS seasonstatsView;
CREATE VIEW seasonstatsView AS
SELECT
    season.parent_id,
    count(*) AS child_count,
    sum(CASE WHEN season.fetch_type = 1 AND
                 coalesce(ES.total, 0) = coalesce(ES.seenCount, 0)
            THEN 1 ELSE 0 END) AS fully_seen_seasons,
    max(coalesce(ES.latestUpload, 0)) AS max_latest_upload,
    max(coalesce(ES.fetchedAt, 0)) AS max_fetched_at,
    coalesce(max(ES.lastSeen), 0) AS max_last_seen,
    sum(coalesce(ES.bookmarkCount, 0)) AS total_bookmarks,
    sum(coalesce(ES.fillermarkCount, 0)) AS total_fillermarks
FROM animes season
LEFT JOIN episodestatsView ES ON season._id = ES.anime_id
WHERE season.parent_id IS NOT NULL
GROUP BY season.parent_id;

DROP VIEW IF EXISTS seasonsView;
CREATE VIEW seasonsView AS
SELECT
    A.*,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.total, 0)
        WHEN 0 THEN coalesce(SS.child_count, 0)
    END AS totalCount,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.seenCount, 0)
        WHEN 0 THEN coalesce(SS.fully_seen_seasons, 0)
    END AS seenCount,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.latestUpload, 0)
        WHEN 0 THEN coalesce(SS.max_latest_upload, 0)
    END AS latestUpload,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.fetchedAt, 0)
        WHEN 0 THEN coalesce(SS.max_fetched_at, 0)
    END AS fetchedAt,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.lastSeen, 0)
        WHEN 0 THEN coalesce(SS.max_last_seen, 0)
    END AS lastSeen,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.bookmarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_bookmarks, 0)
    END AS bookmarkCount,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.fillermarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_fillermarks, 0)
    END AS fillermarkCount
FROM animes AS A
LEFT JOIN episodestatsView AS EP ON A._id = EP.anime_id
LEFT JOIN seasonstatsView AS SS ON A._id = SS.parent_id
WHERE A.parent_id IS NOT NULL;

DROP VIEW IF EXISTS libraryView;
CREATE VIEW libraryView AS
SELECT
    A.*,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.total, 0)
        WHEN 0 THEN coalesce(SS.child_count, 0)
    END AS totalCount,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.seenCount, 0)
        WHEN 0 THEN coalesce(SS.fully_seen_seasons, 0)
    END AS seenCount,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.latestUpload, 0)
        WHEN 0 THEN coalesce(SS.max_latest_upload, 0)
    END AS latestUpload,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.fetchedAt, 0)
        WHEN 0 THEN coalesce(SS.max_fetched_at, 0)
    END AS episodeFetchedAt,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.lastSeen, 0)
        WHEN 0 THEN coalesce(SS.max_last_seen, 0)
    END AS lastSeen,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.bookmarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_bookmarks, 0)
    END AS bookmarkCount,
    CASE A.fetch_type
        WHEN 1 THEN coalesce(EP.fillermarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_fillermarks, 0)
    END AS fillermarkCount,
    coalesce(AC.category_id, 0) AS category
FROM animes A
LEFT JOIN episodestatsView AS EP
ON A._id = EP.anime_id
LEFT JOIN seasonstatsView AS SS
ON A._id = SS.parent_id
LEFT JOIN animes_categories AS AC
ON AC.anime_id = A._id
WHERE A.source <> 6969
UNION
SELECT
    A.*,
    coalesce(EP.total, 0) AS totalCount,
    coalesce(EP.seenCount, 0) AS seenCount,
    coalesce(EP.latestUpload, 0) AS latestUpload,
    coalesce(EP.fetchedAt, 0) AS episodeFetchedAt,
    coalesce(EP.lastSeen, 0) AS lastSeen,
    coalesce(EP.bookmarkCount, 0) AS bookmarkCount,
    -- AM (FILLERMARK) -->
    coalesce(EP.fillermarkCount, 0) AS fillermarkCount,
    -- <-- AM (FILLERMARK)
    coalesce(AC.category_id, 0) AS category
FROM animes A
LEFT JOIN (
    SELECT merged.anime_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = A._id
LEFT JOIN mergedepisodestatsView AS EP
ON A._id = EP.merge_id
LEFT JOIN animes_categories AS AC
ON AC.anime_id = A._id
WHERE A.source = 6969;

DROP VIEW IF EXISTS deletableView;
CREATE VIEW deletableView AS
SELECT
    A._id,
    A.source,
    A.fetch_type
FROM animes AS A
WHERE A.favorite = 0
AND A.parent_id IS NULL;
